@page "/processos"
@using AppWebGabriel.DAO
@using AppWebGabriel.Model
@rendermode InteractiveServer
@inject ProcessoDAO dao
@inject NavigationManager NavigationManager

<h3>Processos</h3>

<p>
    <a href="/processos/cadastro" class="btn btn-primary">Novo Processo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Número</th>
            <th>Interessado</th>
            <th>Assunto</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in listaProcessos)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Numero</td>
                <td>@p.Interessado</td>
                <td>@p.Assunto</td>
                <td>@p.Situacao</td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a href="@($"/processos/editar/{p.Id}")" class="btn btn-light border text-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="@($"/processos/excluir/{p.Id}")" class="btn btn-light border text-danger" title="Excluir">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Processo> listaProcessos = new();

    protected override void OnInitialized()
    {
        listaProcessos = dao.Listar();
    }
}